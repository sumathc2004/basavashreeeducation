# Namma API payment gateway credentials (server-only — never exposed to the client)
NAMMA_API_BASE_URL=https://api.nammapi.example.com
NAMMA_API_KEY=replace-with-real-key
NAMMA_WEBHOOK_SECRET=replace-with-webhook-signing-secret

# When the values above are left unset, the site runs in mock payment mode
# so the full checkout flow can be developed and demoed without live credentials.

# Site-wide access gate (see middleware.ts) — the entire site is private
# behind these credentials. Set SITE_GATE_SECRET to a real random value in
# any environment you care about protecting; without it, the code falls back
# to a secret baked into the repo, which anyone reading the source could use
# to forge access.
SITE_GATE_PHONE=9902820080
SITE_GATE_PASSWORD=9902820080
SITE_GATE_SECRET=replace-with-a-long-random-string
