# Namma API payment gateway credentials (server-only — never exposed to the client)
NAMMA_API_BASE_URL=https://api.nammapi.example.com
NAMMA_API_KEY=replace-with-real-key
NAMMA_WEBHOOK_SECRET=replace-with-webhook-signing-secret

# When the values above are left unset, the site runs in mock payment mode
# so the full checkout flow can be developed and demoed without live credentials.
